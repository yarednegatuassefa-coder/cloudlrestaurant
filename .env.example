# Optional public Sentry project DSN. Leave blank to keep client error reporting disabled.
VITE_SENTRY_DSN=

# Optional local Nemotron inference. Disabled by default; see docs/nemotron-local-inference.md.
NEMOTRON_ENABLED=false
NEMOTRON_BASE_URL=http://127.0.0.1:8080/v1
NEMOTRON_MODEL=nemotron-bolt
NEMOTRON_TIMEOUT_MS=20000
